# Copy this to .env on the VPS and fill in the values.
# Never commit the real .env file.

# A long random string shared between this server and Vercel (VULTR_CACHE_SECRET)
CACHE_SECRET=replace_with_long_random_string

# Redis connection (default: local Redis on standard port)
REDIS_URL=redis://127.0.0.1:6379

# Port for this cache server
PORT=3001
